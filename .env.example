# Copie para .env.local e preencha com os dados do SEU projeto Supabase (Project Settings → API).
# Este arquivo é só modelo: nunca coloque valores reais aqui.
# Use SOMENTE a chave pública (publishable / anon). NUNCA a service_role / secret.
VITE_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<chave publishable ou anon>
